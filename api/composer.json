{
  "name": "jobpilot/local-api",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-json": "*",
    "ext-sodium": "*",
    "ext-zip": "*",
    "doctrine/dbal": "^4.3",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "3.6.7",
    "symfony/console": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/flex": "^2.7",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-client": "^8.1",
    "symfony/mime": "^8.1",
    "symfony/monolog-bundle": "^4.0",
    "symfony/runtime": "^8.1",
    "symfony/serializer": "^8.1",
    "symfony/string": "^8.1",
    "symfony/validator": "^8.1",
    "symfony/yaml": "^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "symfony/test-pack": "^1.2"
  },
  "autoload": {
    "psr-4": {"App\\": "src/"}
  },
  "autoload-dev": {
    "psr-4": {"App\\Tests\\": "tests/"}
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd"
    },
    "post-install-cmd": ["@auto-scripts"],
    "post-update-cmd": ["@auto-scripts"]
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.1.*"
    }
  }
}
