{
  "manifest_version": 3,
  "name": "JobPilot Local",
  "version": "0.3.0",
  "description": "Importe les offres visibles dans le catalogue canonique JobPilot et analyse les formulaires de candidature localement.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["http://localhost:8080/*", "http://127.0.0.1:8080/*", "<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "JobPilot", "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["form-detector.js", "content.js"], "run_at": "document_idle" }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
