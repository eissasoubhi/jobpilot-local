POSTGRES_DB=jobpilot
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot
POSTGRES_PORT=5432
APP_SECRET=change-me
APP_ENCRYPTION_KEY=replace-with-base64-32-byte-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/gmail/callback
WEB_URL=http://localhost:3000
GMAIL_SEARCH_QUERY=(job OR mission OR candidature OR application OR recruiter OR entretien) newer_than:30d
GMAIL_MAX_RESULTS=100
GMAIL_MAX_PAGES=3

# Recherche automatique d'offres
# Arbeitnow fonctionne sans clé. Symfony Jobs utilise le flux RSS officiel.
# Adzuna et France Travail nécessitent des identifiants développeur personnels.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=fr
ADZUNA_WHERE=
ADZUNA_RESULTS_PER_QUERY=20
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre
FRANCE_TRAVAIL_TOKEN_ENDPOINT=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=/partenaire
FRANCE_TRAVAIL_SEARCH_ENDPOINT=https://api.francetravail.io/partenaire/offresdemploi/v2/offres/search
FRANCE_TRAVAIL_RESULTS_PER_QUERY=50
ARBEITNOW_ENABLED=1
ARBEITNOW_PAGES=3
SYMFONY_JOBS_RSS_ENABLED=1
JOB_SYNC_INTERVAL_SECONDS=21600

# Notification HTTPS facultative des alertes de fraîcheur des connecteurs.
# Laisser l'URL vide désactive complètement les envois.
CONNECTOR_ALERT_WEBHOOK_URL=
CONNECTOR_ALERT_WEBHOOK_ALLOWED_HOST=
CONNECTOR_ALERT_WEBHOOK_SECRET=
