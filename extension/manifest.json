{
  "manifest_version": 3,
  "name": "JobPilot Local",
  "version": "1.0.0",
  "description": "Importe les offres visibles dans JobPilot et préremplit les formulaires avec validation manuelle.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["http://localhost:8080/*", "http://127.0.0.1:8080/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "JobPilot", "default_popup": "popup.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
