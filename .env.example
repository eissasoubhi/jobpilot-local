POSTGRES_DB=jobpilot
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot
POSTGRES_PORT=5432
APP_SECRET=change-me
APP_ENCRYPTION_KEY=replace-with-base64-32-byte-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/gmail/callback
WEB_URL=http://localhost:3000
GMAIL_SEARCH_QUERY=(job OR emploi OR offre OR mission OR candidature OR application OR recruiter OR entretien) newer_than:30d
GMAIL_MAX_RESULTS=100
GMAIL_MAX_PAGES=3

# Recherche automatique d'offres
# Arbeitnow fonctionne sans clé. Symfony Jobs utilise le flux RSS officiel.
# Le Studio Tech utilise les pages publiques de missions avec contrôle robots.txt obligatoire.
# Adzuna, France Travail et SmartRecruiters nécessitent des identifiants développeur personnels.
# Ces identifiants peuvent aussi être gérés depuis Paramètres > Configuration & clés API.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=fr
ADZUNA_WHERE=
ADZUNA_RESULTS_PER_QUERY=20
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre
FRANCE_TRAVAIL_TOKEN_ENDPOINT=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=/partenaire
FRANCE_TRAVAIL_SEARCH_ENDPOINT=https://api.francetravail.io/partenaire/offresdemploi/v2/offres/search
FRANCE_TRAVAIL_RESULTS_PER_QUERY=50
SMARTRECRUITERS_API_TOKEN=
SMARTRECRUITERS_COMPANY_IDENTIFIERS=
SMARTRECRUITERS_PAGES=1
SMARTRECRUITERS_RESULTS_PER_PAGE=100
SMARTRECRUITERS_MAX_DETAILS=20
ARBEITNOW_ENABLED=1
ARBEITNOW_PAGES=3
SYMFONY_JOBS_RSS_ENABLED=1
LE_STUDIO_TECH_ENABLED=1
LE_STUDIO_TECH_PAGES=8
LE_STUDIO_TECH_MAX_DETAILS=20
JOB_SYNC_INTERVAL_SECONDS=21600

# Matching IA expérimental.
# Désactivé par défaut : sans clé ou en cas d'erreur/quota, JobPilot conserve le matcher déterministe.
# Pour le test gratuit Gemini, ne jamais committer la clé et limiter les données envoyées aux critères de matching.
AI_MATCHING_ENABLED=0
GEMINI_API_KEY=
GEMINI_MATCHING_MODEL=gemini-3.5-flash-lite

# Limites du projet Gemini à recopier depuis Google AI Studio pour le modèle actif.
# Les valeurs ci-dessous correspondent au profil de test Gemini 3.5 Flash-Lite observé lors de l'intégration.
# JobPilot n'utilise par défaut que 80 % de ces plafonds afin de garder une marge face aux appels externes au projet.
GEMINI_QUOTA_RPM=15
GEMINI_QUOTA_TPM=250000
GEMINI_QUOTA_RPD=500
AI_QUOTA_SAFETY_PERCENT=80

# Providers IA alternatifs. Les clés peuvent être stockées depuis l'interface dès maintenant ;
# leur utilisation comme moteur de matching sera activée dans des PR provider spécifiques.
OPENAI_API_KEY=
OPENAI_MATCHING_MODEL=
MISTRAL_API_KEY=
MISTRAL_MATCHING_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MATCHING_MODEL=

# Notification HTTPS facultative des alertes de fraîcheur des connecteurs.
# Laisser l'URL vide désactive complètement les envois.
CONNECTOR_ALERT_WEBHOOK_URL=
CONNECTOR_ALERT_WEBHOOK_ALLOWED_HOST=
CONNECTOR_ALERT_WEBHOOK_SECRET=
